<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" stylesheets="@../css/home.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Dashboard.HomePageController">
    <HBox prefHeight="70.0" prefWidth="901.0" styleClass="sidebar" stylesheets="@../css/home.css">

        <Label styleClass="header-title" stylesheets="@../css/home.css" text="📚 Library Management System" />

    </HBox>


    <!-- Sidebar -->
    <VBox layoutX="0.0" layoutY="78.0" prefHeight="572.0" prefWidth="220.0" spacing="15.0" styleClass="sidebar" stylesheets="@../css/home.css">

        <Label styleClass="menu-title" text="MENU" />

        <Button styleClass="menu-button" text="Dashboard" />

        <Button styleClass="menu-button" text="📖  Books" />

        <Button styleClass="menu-button" text="👥  Members" />

        <Button styleClass="menu-button" text="📤  Issue Book" />

        <Button styleClass="menu-button" text="📥  Return Book" />

        <Button styleClass="menu-button" text="📋  Borrowing History" />

    </VBox>


    <!-- Main Content -->
    <VBox layoutX="250.0" layoutY="100.0" prefWidth="800.0" spacing="25.0" stylesheets="@../css/home.css">

        <Label styleClass="dashboard-title" text="Welcome to Library Dashboard" />

        <Label styleClass="dashboard-subtitle" text="Manage books, members and borrowing records" />


        <!-- First Row -->
        <HBox spacing="25.0">

            <VBox prefHeight="150.0" prefWidth="360.0" styleClass="dashboard-card" stylesheets="@../css/home.css">

                <Label styleClass="card-icon" text="📚" />

                <Label styleClass="card-title" text="Total Books" />

                <Label styleClass="card-value" text="250" />

            </VBox>


            <VBox prefHeight="150.0" prefWidth="360.0" styleClass="dashboard-card">

                <Label styleClass="card-icon" text="👥" />

                <Label styleClass="card-title" text="Total Members" />

                <Label styleClass="card-value" text="120" />

            </VBox>

        </HBox>


        <!-- Second Row -->
        <HBox spacing="25.0">

            <VBox prefHeight="150.0" prefWidth="360.0" styleClass="dashboard-card">

                <Label styleClass="card-icon" text="📕" />

                <Label styleClass="card-title" text="Currently Borrowed" />

                <Label styleClass="card-value" text="35" />

            </VBox>


            <VBox prefHeight="150.0" prefWidth="360.0" styleClass="dashboard-card">

                <Label styleClass="card-icon" text="⚠" />

                <Label styleClass="card-title" text="Overdue Books" />

                <Label styleClass="card-value" text="8" />

            </VBox>

        </HBox>
      <styleClass>
         <String fx:value="card-title" />
         <String fx:value="card-icon" />
         <String fx:value="card-value" />
      </styleClass>

    </VBox>

     <Button fx:id="logoutButton" layoutX="926.0" layoutY="15.0" styleClass="logout-button" stylesheets="@../css/home.css" text="Logout" />
</AnchorPane>
