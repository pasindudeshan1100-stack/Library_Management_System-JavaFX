<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="596.0" prefWidth="922.0" styleClass="root" stylesheets="@../css/home.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Books.BookPageController">


    <!-- MAIN CONTENT -->

    <VBox layoutX="54.0" layoutY="121.0" prefHeight="102.0" prefWidth="730.0" spacing="20">

        <!-- TITLE -->

        <HBox alignment="CENTER_LEFT" prefHeight="54.0" prefWidth="746.0">
   
            <TextField fx:id="searchField" prefHeight="38.0" prefWidth="683.0" promptText="Search by book title, author or ISBN..." styleClass="header">
            <stylesheets>
               <URL value="@../css/Book.css" />
               <URL value="@../css/IssueBook.css" />
            </stylesheets>
         </TextField>

        </HBox>


        <!-- SEARCH -->

        <HBox spacing="10" />

    </VBox>
   <DialogPane layoutX="274.0" layoutY="334.0" />

                        <Button layoutX="328.0" layoutY="535.0" onAction="#AddBooksbtnOnAction" prefHeight="26.0" prefWidth="87.0" styleClass="add-button" stylesheets="@../css/Book.css" text="Add" />
   <Button layoutX="429.0" layoutY="535.0" prefHeight="28.0" prefWidth="87.0" styleClass="add-button" stylesheets="@../css/Book.css" text="Update" />
   <Button layoutX="530.0" layoutY="535.0" prefHeight="28.0" prefWidth="87.0" styleClass="add-button" stylesheets="@../css/Book.css" text="Delete" />

       <Label alignment="CENTER" layoutX="-4.0" layoutY="-4.0" prefHeight="94.0" prefWidth="926.0" style="-fx-background-color: #e7af36;" text="Books" textFill="#f2f0f0">
      <font>
         <Font name="System Bold" size="36.0" />
      </font>
   </Label>

       <Label layoutX="403.0" layoutY="63.0" text="Manage library books" textFill="#fcfafa" />

   
        <!-- TABLE -->

        <TableView fx:id="bookTable" accessibleRole="DATE_PICKER" layoutX="24.0" layoutY="214.0" prefHeight="266.0" prefWidth="860.0">

            <columns>

                <TableColumn fx:id="idColumn" prefWidth="60" text="ID" />

                <TableColumn fx:id="isbnColumn" prefWidth="112.0" text="ISBN" />

                <TableColumn fx:id="titleColumn" prefWidth="157.6000518798828" text="Book Title" />

                <TableColumn fx:id="authorColumn" prefWidth="156.0" text="Author" />

                <TableColumn fx:id="categoryColumn" prefWidth="116.79998779296875" text="Category" visible="false" />

                <TableColumn fx:id="yearColumn" prefWidth="144.00006103515625" text="Year" />

                <TableColumn fx:id="quantityColumn" prefWidth="116.79998779296875" text="Quantity" />

                <TableColumn fx:id="actionColumn" prefWidth="111.20001220703125" text="Actions" />

            </columns>
      <styleClass>
         <String fx:value="book-table" />
         <String fx:value="table-row-cell" />
         <String fx:value="book-table" />
      </styleClass>

        </TableView>

                              <Button layoutX="777.0" layoutY="131.0" prefHeight="34.0" prefWidth="78.0" styleClass="add-button" stylesheets="@../css/Book.css" text="Search" />
</AnchorPane>
