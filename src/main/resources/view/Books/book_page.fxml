<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" styleClass="root" stylesheets="@../css/home.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Books.BookPageController">
    <HBox layoutX="0" layoutY="0" prefHeight="70" prefWidth="1100" styleClass="header">

        <Label styleClass="header-title" text="📚 Library Management System" />

    </HBox>


    <!-- SIDEBAR -->

    <VBox layoutX="0" layoutY="70" prefHeight="580" prefWidth="220" spacing="15" styleClass="sidebar" stylesheets="@../css/home.css">

        <Label styleClass="menu-title" text="MENU" />

        <Button styleClass="menu-button" text="Dashboard" />

        <Button styleClass="menu-button" text="📖  Books" />

        <Button styleClass="menu-button" text="👥  Members" />
   
        <Button prefHeight="45.0" prefWidth="142.0" styleClass="menu-button" text="📤  Issue Book" />
   
           <Button prefHeight="39.0" prefWidth="142.0" styleClass="menu-button" text="📥  Return Book" />
   
        <Button styleClass="menu-button" text="📋  Borrowing History" />

    </VBox>


    <!-- MAIN CONTENT -->

    <VBox layoutX="245" layoutY="95" prefHeight="101.0" prefWidth="838.0" spacing="20">

        <!-- TITLE -->

        <HBox alignment="CENTER_LEFT" prefHeight="53.0" prefWidth="722.0">

            <VBox>

                <Label prefHeight="34.0" prefWidth="101.0" styleClass="dashboard-title" text="Books" />

                <Label styleClass="dashboard-subtitle" text="Manage library books" />

            </VBox>

        </HBox>


        <!-- SEARCH -->

        <HBox spacing="10">

            <TextField fx:id="searchField" prefHeight="39.0" prefWidth="590.0" promptText="Search by book title, author or ISBN..." styleClass="header">
            <stylesheets>
               <URL value="@../css/Book.css" />
               <URL value="@../css/IssueBook.css" />
            </stylesheets></TextField>

            <Button prefHeight="38.0" prefWidth="82.0" styleClass="add-button" stylesheets="@../css/Book.css" text="Search" />

        </HBox>


        <!-- TABLE -->

        <TableView fx:id="bookTable" accessibleRole="DATE_PICKER" prefHeight="70.0" prefWidth="838.0">

            <columns>

                <TableColumn fx:id="idColumn" prefWidth="60" text="ID" />

                <TableColumn fx:id="isbnColumn" prefWidth="120" text="ISBN" />

                <TableColumn fx:id="titleColumn" prefWidth="163.20001220703125" text="Book Title" />

                <TableColumn fx:id="authorColumn" prefWidth="140.0" text="Author" />

                <TableColumn fx:id="categoryColumn" prefWidth="116.79998779296875" text="Category" visible="false" />

                <TableColumn fx:id="yearColumn" prefWidth="80" text="Year" />

                <TableColumn fx:id="quantityColumn" prefWidth="180.79998779296875" text="Quantity" />

                <TableColumn fx:id="actionColumn" prefWidth="93.60001220703123" text="Actions" />

            </columns>
         <styleClass>
            <String fx:value="book-table" />
            <String fx:value="table-row-cell" />
            <String fx:value="book-table" />
         </styleClass>

        </TableView>

    </VBox>
   <DialogPane layoutX="274.0" layoutY="334.0" />

                        <Button layoutX="528.0" layoutY="588.0" prefHeight="34.0" prefWidth="87.0" styleClass="add-button" stylesheets="@../css/Book.css" text="Add" />
   <Button layoutX="634.0" layoutY="588.0" prefHeight="34.0" prefWidth="87.0" styleClass="add-button" stylesheets="@../css/Book.css" text="Update" />
   <Button layoutX="736.0" layoutY="588.0" prefHeight="34.0" prefWidth="87.0" styleClass="add-button" stylesheets="@../css/Book.css" text="Delete" />
</AnchorPane>
