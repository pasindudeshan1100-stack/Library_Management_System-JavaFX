<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="672.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Books.BookPageController">


    <VBox layoutX="14.0" prefHeight="720.0" prefWidth="220.0" spacing="15.0" styleClass="sidebar" stylesheets="@../css/home.css">
        <padding>
            <Insets bottom="20" left="15" right="15" top="28" />
        </padding>

        <!-- BRAND -->
        <Label styleClass="brand-title" text="📚  Library" />

        <Label styleClass="brand-subtitle" text="       MANAGEMENT SYSTEM" />


        <Label styleClass="menu-title" text="MENU">
            <VBox.margin>
                <Insets top="15.0" />
            </VBox.margin></Label>

        <Button onAction="#DashboardbtnOnAction" styleClass="menu-button" text="🏠 Dashboard" />

        <Button onAction="#BooksbtnOnAction" styleClass="menu-button" text="📖  Books" />

        <Button onAction="#MemberbtnOnAction" styleClass="menu-button" text="👥  Members" />

        <Button onAction="#IssuebtnOnAction" styleClass="menu-button" text="📤  Issue Book" />

        <Button onAction="#ReturnbtnOnAction" styleClass="menu-button" text="📥  Return Book" />

        <Button onAction="#HistorybtnOnAction" styleClass="menu-button" text="📋  Borrowing History" />

        <Button fx:id="logoutButton" styleClass="logout-button" stylesheets="@../css/home.css" text="Logout">
            <VBox.margin>
                <Insets top="150.0" />
            </VBox.margin>
        </Button>

    </VBox>
    <!-- MAIN CONTENT -->

    <VBox layoutX="54.0" layoutY="121.0" prefHeight="102.0" prefWidth="730.0" spacing="20">


        <!-- SEARCH -->

        <HBox spacing="10" />

    </VBox>
   <DialogPane layoutX="274.0" layoutY="334.0" />

                        <Button layoutX="607.0" layoutY="216.0" onAction="#AddBooksbtnOnAction" prefHeight="36.0" prefWidth="87.0" styleClass="btn-add" stylesheets="@../css/btn.css" text=" Add Book" />

       <Label layoutX="403.0" layoutY="63.0" text="Manage library books" textFill="#fcfafa" />

   
        <!-- TABLE -->

        <TableView fx:id="bookTable" accessibleRole="DATE_PICKER" layoutX="234.0" layoutY="299.0" prefHeight="266.0" prefWidth="800.0">

            <columns>

                <TableColumn fx:id="idColumn" prefWidth="60" text="ID" />

                <TableColumn fx:id="authorColumn" prefWidth="156.0" text="Author" />

                <TableColumn fx:id="categoryColumn" prefWidth="116.79998779296875" text="Category" visible="false" />

                <TableColumn fx:id="categoryColumn" prefWidth="127.99996948242188" text="Category" />

                <TableColumn fx:id="yearColumn" prefWidth="148.79998779296875" text="Published Year" />
         <TableColumn fx:id="quantityColumn" prefWidth="112.0" text="Quantity" />

                            <TableColumn fx:id="titleColumn" prefWidth="157.6000518798828" text="Book Title" />

            </columns>
      <styleClass>
         <String fx:value="book-table" />
         <String fx:value="table-row-cell" />
         <String fx:value="book-table" />
      </styleClass>

        </TableView>

         <TextField fx:id="searchField" layoutX="246.0" layoutY="212.0" prefHeight="38.0" prefWidth="331.0" promptText="Search by book title, author or ISBN..." styleClass="header">
      <stylesheets>
         <URL value="@../css/Book.css" />
         <URL value="@../css/IssueBook.css" />
      </stylesheets>
   </TextField>
</AnchorPane>
