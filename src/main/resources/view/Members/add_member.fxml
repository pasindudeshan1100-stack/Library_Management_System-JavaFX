<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="347.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Members.AddMemberPageController">
   <children>
       <VBox spacing="22" styleClass="content" stylesheets="@../css/Member.css">
           <padding>
               <Insets bottom="30" left="30" right="30" top="30" />
           </padding>

           <VBox spacing="6">
               <Label styleClass="page-title" text="Add Member" />
               <Label styleClass="subtitle" text="Register a new member to the library system" />
           </VBox>

           <HBox spacing="25" styleClass="form-card">
               <padding>
                   <Insets bottom="25" left="25" right="25" top="25" />
               </padding>


               <VBox spacing="18" HBox.hgrow="ALWAYS">

                   <VBox spacing="7">
                       <Label styleClass="field-label" text="Member ID" />
                       <TextField fx:id="txtMemberId" promptText="e.g. M001" styleClass="input-field" />
                   </VBox>

                   <VBox spacing="7">
                       <Label styleClass="field-label" text="Full Name" />
                       <TextField fx:id="txtFullName" promptText="Enter full name" styleClass="input-field" />
                   </VBox>

                   <VBox spacing="7">
                       <Label styleClass="field-label" text="Email Address" />
                       <TextField fx:id="txtEmail" promptText="Enter email address" styleClass="input-field" />
                   </VBox>

                   <VBox spacing="7">
                       <Label styleClass="field-label" text="Phone Number" />
                       <TextField fx:id="txtPhone" promptText="e.g. 0712345678" styleClass="input-field" />
                   </VBox>

                   <VBox spacing="7">
                       <Label styleClass="field-label" text="Address" />
                       <TextArea fx:id="txtAddress" prefRowCount="3" promptText="Enter full address" styleClass="input-field" wrapText="true" />
                   </VBox>

                   <Label fx:id="lblMessage" styleClass="message-label" text="" wrapText="true" />

                   <HBox spacing="12">
                       <Button onAction="#AddbtnOnAction" styleClass="primary-button" text="＋  Add Member" />

                       <Button onAction="#ResetbtnOnAction" styleClass="secondary-button" text="↻  Reset" />
                   </HBox>

               </VBox>


               <VBox alignment="CENTER" prefWidth="200" spacing="18" styleClass="info-panel">

                   <Label styleClass="member-icon" text="♙" />

                   <Label styleClass="info-title" text="New Member" />

                   <Label styleClass="info-text" text="Add a new reader to your library community." wrapText="true" />

                   <Separator />

                   <Label styleClass="quote-text" text="Good readers make better thinkers." wrapText="true" />
               </VBox>
           </HBox>
       </VBox>
   </children>
</AnchorPane>
