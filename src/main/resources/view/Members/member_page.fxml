<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="txtAdrss" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.Members.MemberPageController">
    <VBox layoutX="0.0" layoutY="95.0" prefHeight="581.0" prefWidth="220.0" spacing="15.0" styleClass="sidebar" stylesheets="@../css/home.css">

        <Label styleClass="menu-title" text="MENU">
            <VBox.margin>
                <Insets top="15.0" />
            </VBox.margin></Label>

        <Button onAction="#DashboardbtnOnAction" styleClass="menu-button" text="🏠 Dashboard" />

        <Button onAction="#BooksbtnOnAction" styleClass="menu-button" text="📖  Books" />

        <Button onAction="#MemberbtnOnAction" styleClass="menu-button" text="👥  Members" />

        <Button onAction="#IssuebtnOnAction" styleClass="menu-button" text="📤  Issue Book" />

        <Button onAction="#ReturnbtnOnAction" styleClass="menu-button" text="📥  Return Book" />

        <Button onAction="#HistorybtnOnAction" styleClass="menu-button" text="📋  Borrowing History" />

        <Button fx:id="logoutButton" styleClass="logout-button" stylesheets="@../css/home.css" text="Logout">
            <VBox.margin>
                <Insets top="25.0" />
            </VBox.margin>
        </Button>

    </VBox>

    <Label alignment="CENTER" prefHeight="82.0" prefWidth="904.0" style="-fx-background-color: #e7af36;" text="Members" textFill="#ecebe9">
      <font>
         <Font name="System Bold" size="36.0" />
      </font>
   </Label>
   <Label layoutX="404.0" layoutY="58.0" text="Manage Members" textFill="#f7f2f2" />
   <TextField layoutX="268.0" layoutY="155.0" prefHeight="34.0" prefWidth="461.0" promptText="Enter your Member Id" />
   <Button layoutX="712.0" layoutY="139.0" mnemonicParsing="false" styleClass="login-button" stylesheets="@../css/Style.css" text="Search" />
   <TableView fx:id="tblMembers" layoutX="240.0" layoutY="220.0" prefHeight="235.0" prefWidth="650.0">
     <columns>
       <TableColumn fx:id="colMemberId" prefWidth="75.0" text="Member ID" />
       <TableColumn fx:id="colName" prefWidth="145.5999755859375" text="Full Name" />
         <TableColumn fx:id="colEmail" prefWidth="133.60003662109375" text="Email" />
         <TableColumn fx:id="colPhonenumber" prefWidth="124.79998779296875" text="Phone Number" />
         <TableColumn fx:id="colAdress" prefWidth="169.59995117187498" text="Adress" />
     </columns>
   </TableView>
   <Button layoutX="412.0" layoutY="554.0" mnemonicParsing="false" onAction="#AddMemberbtnOnAction" styleClass="login-button" stylesheets="@../css/Style.css" text="Add " />
   <Button layoutX="646.0" layoutY="538.0" mnemonicParsing="false" styleClass="login-button" stylesheets="@../css/Style.css" text="Delete" />
   <Button layoutX="510.0" layoutY="537.0" mnemonicParsing="false" styleClass="login-button" stylesheets="@../css/Style.css" text="Update" />

</AnchorPane>
